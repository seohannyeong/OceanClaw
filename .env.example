# Gemini API 키 (필수) - https://aistudio.google.com/apikey
GEMINI_API_KEY=여기에_키_입력

# 모델명 (선택) - 접근 가능한 모델로 변경 가능
# 계획서 기준 예시: GEMINI_MODEL=gemini-3.1-flash / EMBED_MODEL=gemini-embedding-001
GEMINI_MODEL=gemini-2.5-flash
EMBED_MODEL=text-embedding-004

# 데이터 경로 (선택) - 실제 파일로 바꾸려면 여기 수정
# PDF_PATH=data/manual.pdf
# CSV_PATH=data/maintenance_logs.csv
